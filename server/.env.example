# Copy to .env for local work. On Railway, set these under the service's Variables tab.
NODE_ENV=development
PORT=3000
# Local: SQLite file. Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:./dev.db
# Only for a public Postgres URL that requires SSL
DATABASE_SSL=false
# Set to true on Railway so rate limits use the real client IP
TRUST_PROXY=false
# Web origins allowed to call the API (the Ops Console), comma separated
ALLOWED_ORIGINS=
SESSION_DAYS=30
RESET_MINUTES=30
